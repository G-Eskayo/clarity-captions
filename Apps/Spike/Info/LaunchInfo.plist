<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The launch screen is the icon's teal (a darker teal in Dark Mode), so there is no mismatched flash. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- The app makes no network calls and uses no encryption of its own, so App Store Connect
	     stops asking the export-compliance question on every upload (#79). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- No feedback recipient (#137): TestFlight and App Store share one build, so a number here would ship in the App
	     Store app. "Send feedback to Gil" opens the share sheet instead (ADR 0023's fallback). -->
	<!-- Lets the launch animation run at the display's full rate on ProMotion iPhones (120 Hz) instead of being
	     held to 60 (#119). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Bundled lettering fonts (#103): OpenDyslexic (the default) and Atkinson Hyperlegible, SIL OFL 1.1. -->
	<key>UIAppFonts</key>
	<array>
		<string>OpenDyslexic-Regular.otf</string>
		<string>OpenDyslexic-Bold.otf</string>
		<string>OpenDyslexic-Italic.otf</string>
		<string>OpenDyslexic-BoldItalic.otf</string>
		<string>AtkinsonHyperlegible-Regular.ttf</string>
		<string>AtkinsonHyperlegible-Bold.ttf</string>
		<string>AtkinsonHyperlegible-Italic.ttf</string>
		<string>AtkinsonHyperlegible-BoldItalic.ttf</string>
	</array>
</dict>
</plist>
