<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug: no sandbox, so the screenshot contract can write where it is told (Release is sandboxed for TestFlight). -->
	<!-- Room mode: the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
